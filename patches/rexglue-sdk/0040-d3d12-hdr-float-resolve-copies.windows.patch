+void D3D12Presenter::UpdateHdrDisplay() {
+  IDXGISwapChain3* swap_chain = paint_context_.swap_chain.Get();
+  if (!swap_chain) {
+    return;
+  }
+  // The display, and whether Windows HDR is on for it.
+  bool display_hdr = false;
+  float peak_nits = 0.0f;
+  float sdr_white_nits = 0.0f;
+  Microsoft::WRL::ComPtr<IDXGIOutput> output;
+  Microsoft::WRL::ComPtr<IDXGIOutput6> output6;
+  if (SUCCEEDED(swap_chain->GetContainingOutput(&output)) && SUCCEEDED(output.As(&output6))) {
+    DXGI_OUTPUT_DESC1 output_desc;
+    if (SUCCEEDED(output6->GetDesc1(&output_desc))) {
+      display_hdr = output_desc.ColorSpace == DXGI_COLOR_SPACE_RGB_FULL_G2084_NONE_P2020;
+      peak_nits = output_desc.MaxLuminance;
+      sdr_white_nits = GetSdrWhiteNits(output_desc.DeviceName);
+    }
+  }
+  constexpr DXGI_COLOR_SPACE_TYPE kScRgb = DXGI_COLOR_SPACE_RGB_FULL_G10_NONE_P709;
+  UINT color_space_support = 0;
+  if (SUCCEEDED(swap_chain->CheckColorSpaceSupport(kScRgb, &color_space_support)) &&
+      (color_space_support & DXGI_SWAP_CHAIN_COLOR_SPACE_SUPPORT_FLAG_PRESENT)) {
+    swap_chain->SetColorSpace1(kScRgb);
+  } else {
+    REXLOG_WARN("D3D12Presenter: The swap chain doesn't support the scRGB color space");
+  }
+  SetHdrDisplayInfo(display_hdr, peak_nits, sdr_white_nits);
+  static bool logged_display_hdr = false, logged_once = false;
+  if (!logged_once || logged_display_hdr != display_hdr) {
+    logged_once = true;
+    logged_display_hdr = display_hdr;
+    REXLOG_INFO("HDR output: scRGB swap chain, display {} (peak {:.0f} nits, SDR white {:.0f} nits)",
+                display_hdr ? "in HDR mode" : "in SDR mode (Windows HDR is off)", peak_nits,
+                sdr_white_nits);
+  }
+}
