diff --git a/src/graphics/shaders/hdr/apply_hdr.cs.hlsl b/src/graphics/shaders/hdr/apply_hdr.cs.hlsl
new file mode 100644
index 0000000..5480b01
--- /dev/null
+++ b/src/graphics/shaders/hdr/apply_hdr.cs.hlsl
@@ -0,0 +1,76 @@
+// Converts the guest frame to linear scRGB for an HDR (FP16, scRGB) swap chain.
+//
+// The source is either the float copy of the front buffer, taken from the floating-point render
+// target the guest draws its final image to, which goes past 1.0 where the game adds light, or the
+// guest's front buffer texture when there's no float copy. The color is in the gamma space of the
+// guest output. Up to 1.0, it is shown like in SDR, at paper white. The part above 1.0, which SDR
+// clips, is scaled by the highlight strength, and rolls off smoothly towards the peak luminance:
+// per channel, so highlights burn to white like the clipping in SDR, or by the brightest channel,
+// keeping their hue, as set by the highlight saturation.
+
+Texture2D<float4> xe_apply_hdr_source : register(t0);
+RWTexture2D<float4> xe_apply_hdr_dest : register(u0);
+SamplerState xe_apply_hdr_sampler : register(s0);
+
+cbuffer XeApplyHdrConstants : register(b0) {
+  uint2 xe_apply_hdr_size;
+  // The part of the source covering the output in normalized coordinates.
+  float2 xe_apply_hdr_source_uv_scale;
+  // scRGB value of paper white (nits / 80).
+  float xe_apply_hdr_paper_white;
+  // scRGB value of the peak luminance (nits / 80).
+  float xe_apply_hdr_peak;
+  // Gamma of the guest output.
+  float xe_apply_hdr_gamma;
+  // Multiplier of the part of the color above 1.0.
+  float xe_apply_hdr_highlight_strength;
+  // 0 rolls off each channel (white highlights), 1 by the brightest channel (keeping the hue).
+  float xe_apply_hdr_highlight_saturation;
+  // Shows the part above 1.0 instead: gray below, red to yellow above.
+  uint xe_apply_hdr_debug_view;
+};
+
+float XeRollOff(float value, float knee, float headroom) {
+  return value > knee
+             ? (headroom > 0.0 ? knee + headroom * (1.0 - exp(-(value - knee) / headroom)) : knee)
+             : value;
+}
+
+[numthreads(16, 8, 1)]
+void main(uint3 xe_thread_id : SV_DispatchThreadID) {
+  [branch] if (any(xe_thread_id.xy >= xe_apply_hdr_size)) {
+    return;
+  }
+  float2 uv = (float2(xe_thread_id.xy) + 0.5) / float2(xe_apply_hdr_size) *
+              xe_apply_hdr_source_uv_scale;
+  float3 color = xe_apply_hdr_source.SampleLevel(xe_apply_hdr_sampler, uv, 0.0).rgb;
+  // Negative values and NaN to 0.
+  color = max(color, 0.0);
+
+  if (xe_apply_hdr_debug_view) {
+    float brightest_gamma = max(color.r, max(color.g, color.b));
+    float3 debug_color = brightest_gamma > 1.0
+                             ? lerp(float3(1.0, 0.0, 0.0), float3(1.0, 1.0, 0.0),
+                                    saturate((brightest_gamma - 1.0) / 3.0))
+                             : brightest_gamma.xxx * 0.25;
+    xe_apply_hdr_dest[xe_thread_id.xy] =
+        float4(pow(debug_color, 2.2) * xe_apply_hdr_paper_white, 1.0);
+    return;
+  }
+
+  float3 base = min(color, 1.0);
+  float3 gamma_color = base + (color - base) * xe_apply_hdr_highlight_strength;
+  float3 linear_color = pow(gamma_color, xe_apply_hdr_gamma) * xe_apply_hdr_paper_white;
+
+  float knee = min(xe_apply_hdr_paper_white, xe_apply_hdr_peak);
+  float headroom = xe_apply_hdr_peak - knee;
+  float3 per_channel = float3(XeRollOff(linear_color.r, knee, headroom),
+                              XeRollOff(linear_color.g, knee, headroom),
+                              XeRollOff(linear_color.b, knee, headroom));
+  float brightest = max(linear_color.r, max(linear_color.g, linear_color.b));
+  float3 hue_kept =
+      brightest > knee ? linear_color * (XeRollOff(brightest, knee, headroom) / brightest)
+                       : linear_color;
+  xe_apply_hdr_dest[xe_thread_id.xy] =
+      float4(lerp(per_channel, hue_kept, xe_apply_hdr_highlight_saturation), 1.0);
+}
