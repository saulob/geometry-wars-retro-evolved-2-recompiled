+
+Presenter::HdrOutputParameters Presenter::GetHdrOutputParameters() const {
+  HdrOutputParameters parameters;
+  parameters.display_hdr = hdr_display_active_.load(std::memory_order_relaxed);
+  parameters.highlight_strength = float(REXCVAR_GET(hdr_highlight_strength));
+  parameters.highlight_saturation = float(REXCVAR_GET(hdr_highlight_saturation));
+  parameters.debug_view = REXCVAR_GET(hdr_debug_view);
+  if (!parameters.display_hdr) {
+    parameters.paper_white = 1.0f;
+    parameters.peak = 1.0f;
+    return parameters;
+  }
+  float paper_white_nits = float(REXCVAR_GET(hdr_paper_white_nits));
+  if (paper_white_nits <= 0.0f) {
+    paper_white_nits = hdr_display_sdr_white_nits_.load(std::memory_order_relaxed);
+    if (paper_white_nits <= 0.0f) {
+      paper_white_nits = 200.0f;
+    }
+  }
+  parameters.paper_white = std::max(paper_white_nits, 80.0f) / 80.0f;
+  float peak_nits = float(REXCVAR_GET(hdr_peak_nits));
+  if (peak_nits <= 0.0f) {
+    peak_nits = hdr_display_peak_nits_.load(std::memory_order_relaxed);
+    if (peak_nits <= 0.0f) {
+      peak_nits = 1000.0f;
+    }
+  }
+  parameters.peak = std::max(peak_nits / 80.0f, parameters.paper_white);
+  return parameters;
+}
