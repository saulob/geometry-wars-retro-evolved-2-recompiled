+// Copies a floating-point host render target into a float copy of a resolve destination, at the
+// precision and range of the host render target, rather than of the guest format of the resolve.
+
+Texture2D<float4> xe_float_copy_source : register(t0);
+RWTexture2D<float4> xe_float_copy_dest : register(u0);
+
+cbuffer XeFloatCopyConstants : register(b0) {
+  uint2 xe_float_copy_size;
+  // 2^copy_dest_exp_bias.
+  float xe_float_copy_exp_bias;
+  uint xe_float_copy_swap_red_blue;
+};
+
+[numthreads(8, 8, 1)]
+void main(uint3 xe_thread_id : SV_DispatchThreadID) {
+  [branch] if (any(xe_thread_id.xy >= xe_float_copy_size)) {
+    return;
+  }
+  float4 color = xe_float_copy_source[xe_thread_id.xy] * xe_float_copy_exp_bias;
+  if (xe_float_copy_swap_red_blue) {
+    color = color.bgra;
+  }
+  xe_float_copy_dest[xe_thread_id.xy] = color;
+}
