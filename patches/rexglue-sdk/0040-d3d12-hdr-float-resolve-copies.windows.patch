+bool D3D12TextureCache::IsFloatResolveCopyFormat(xenos::TextureFormat format) {
+  switch (format) {
+    case xenos::TextureFormat::k_2_10_10_10:
+    case xenos::TextureFormat::k_2_10_10_10_AS_16_16_16_16:
+    case xenos::TextureFormat::k_16_16_16_16:
+    case xenos::TextureFormat::k_16_16_16_16_FLOAT:
+      return true;
+    default:
+      return false;
+  }
+}
+
+void D3D12TextureCache::InvalidateFloatResolveCopies(uint32_t start, uint32_t length) {
+  if (!length) {
+    return;
+  }
+  start &= 0x1FFFFFFF;
+  uint32_t end = start + length;
+  bool any_invalidated = false;
+  for (FloatResolveCopy& copy : float_resolve_copies_) {
+    if (!copy.valid) {
+      continue;
+    }
+    uint32_t copy_start = copy.dest_base & 0x1FFFFFFF;
+    if (copy_start < end && start < copy_start + copy.dest_length) {
+      copy.valid = false;
+      any_invalidated = true;
+    }
+  }
+  if (any_invalidated) {
+    ResetTextureBindings();
+  }
+}
+
+void D3D12TextureCache::WriteFloatResolveCopy(uint32_t dest_base, uint32_t dest_length,
+                                              uint32_t width, uint32_t height,
+                                              uint32_t host_width, uint32_t host_height,
+                                              D3D12_CPU_DESCRIPTOR_HANDLE source_srv,
+                                              float exp_bias_factor, bool swap_red_blue) {
+  if (!float_resolve_copies_enabled_ || !width || !height || !host_width || !host_height) {
+    return;
+  }
+  dest_base &= 0x1FFFFFFF;
+  InvalidateFloatResolveCopies(dest_base, dest_length);
+
+  FloatResolveCopy* copy = nullptr;
+  for (FloatResolveCopy& existing_copy : float_resolve_copies_) {
+    if (existing_copy.dest_base == dest_base) {
+      copy = &existing_copy;
+      break;
+    }
+  }
+  if (copy && (copy->width != width || copy->height != height ||
+               copy->host_width != host_width || copy->host_height != host_height)) {
+    ReleaseFloatResolveCopy(*copy);
+  }
+  if (!copy) {
+    copy = &float_resolve_copies_.emplace_back();
+    copy->dest_base = dest_base;
+  }
+  copy->dest_length = dest_length;
+  copy->width = width;
+  copy->height = height;
+  copy->host_width = host_width;
+  copy->host_height = host_height;
+
+  const ui::d3d12::D3D12Provider& provider = command_processor_.GetD3D12Provider();
+  ID3D12Device* device = provider.GetDevice();
+  if (!copy->resource) {
+    D3D12_RESOURCE_DESC desc = {};
+    desc.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+    desc.Width = host_width;
+    desc.Height = host_height;
+    desc.DepthOrArraySize = 1;
+    desc.MipLevels = 1;
+    desc.Format = DXGI_FORMAT_R16G16B16A16_FLOAT;
+    desc.SampleDesc.Count = 1;
+    desc.Layout = D3D12_TEXTURE_LAYOUT_UNKNOWN;
+    desc.Flags = D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS;
+    if (FAILED(device->CreateCommittedResource(
+            &ui::d3d12::util::kHeapPropertiesDefault, provider.GetHeapFlagCreateNotZeroed(), &desc,
+            kFloatResolveCopyReadState, nullptr, IID_PPV_ARGS(&copy->resource)))) {
+      REXGPU_ERROR("D3D12TextureCache: Failed to create a {}x{} float resolve copy", host_width,
+                   host_height);
+      return;
+    }
+    REXGPU_INFO("Float resolve copy for {:08X}: {}x{} ({}x{} on the host)", dest_base, width,
+                height, host_width, host_height);
+  }
+
+  ui::d3d12::util::DescriptorCpuGpuHandlePair descriptors[2];
+  if (!command_processor_.RequestOneUseSingleViewDescriptors(2, descriptors)) {
+    return;
+  }
+  device->CopyDescriptorsSimple(1, descriptors[0].first, source_srv,
+                                D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV);
+  D3D12_UNORDERED_ACCESS_VIEW_DESC uav_desc = {};
+  uav_desc.Format = DXGI_FORMAT_R16G16B16A16_FLOAT;
+  uav_desc.ViewDimension = D3D12_UAV_DIMENSION_TEXTURE2D;
+  device->CreateUnorderedAccessView(copy->resource.Get(), nullptr, &uav_desc,
+                                    descriptors[1].first);
+
+  command_processor_.PushTransitionBarrier(copy->resource.Get(), kFloatResolveCopyReadState,
+                                           D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+  struct {
+    uint32_t size[2];
+    float exp_bias;
+    uint32_t swap_red_blue;
+  } constants = {{host_width, host_height}, exp_bias_factor, uint32_t(swap_red_blue)};
+  DeferredCommandList& command_list = command_processor_.GetDeferredCommandList();
+  command_processor_.SetExternalPipeline(float_resolve_copy_pipeline_.Get());
+  command_list.D3DSetComputeRootSignature(load_root_signature_.Get());
+  command_list.D3DSetComputeRoot32BitConstants(0, sizeof(constants) / sizeof(uint32_t),
+                                               &constants, 0);
+  command_list.D3DSetComputeRootDescriptorTable(1, descriptors[0].second);
+  command_list.D3DSetComputeRootDescriptorTable(2, descriptors[1].second);
+  command_processor_.SubmitBarriers();
+  command_list.D3DDispatch((host_width + 7) / 8, (host_height + 7) / 8, 1);
+  command_processor_.PushTransitionBarrier(copy->resource.Get(),
+                                           D3D12_RESOURCE_STATE_UNORDERED_ACCESS,
+                                           kFloatResolveCopyReadState);
+
+  copy->valid = true;
+  ++copy->generation;
+  copy->last_submission = command_processor_.GetCurrentSubmission();
+  ResetTextureBindings();
+}
+
+uint32_t D3D12TextureCache::GetFloatResolveCopyDescriptor(const TextureBinding& binding) {
+  const TextureKey& key = binding.key;
+  if (!key.is_valid || key.dimension != xenos::DataDimension::k2DOrStacked ||
+      key.depth_or_array_size_minus_1 || key.mip_max_level ||
+      !IsFloatResolveCopyFormat(key.format)) {
+    return UINT32_MAX;
+  }
+  uint32_t base = key.base_page << 12;
+  FloatResolveCopy* copy = nullptr;
+  for (FloatResolveCopy& existing_copy : float_resolve_copies_) {
+    if (existing_copy.valid && existing_copy.dest_base == base) {
+      copy = &existing_copy;
+      break;
+    }
+  }
+  if (!copy) {
+    return UINT32_MAX;
+  }
+  uint32_t width = key.GetWidth();
+  uint32_t height = key.GetHeight();
+  if (width > copy->width || height > copy->height) {
+    return UINT32_MAX;
+  }
+
+  const ui::d3d12::D3D12Provider& provider = command_processor_.GetD3D12Provider();
+  ID3D12Device* device = provider.GetDevice();
+  FloatResolveCopyView* view = nullptr;
+  for (FloatResolveCopyView& existing_view : copy->views) {
+    if (existing_view.width == width && existing_view.height == height) {
+      view = &existing_view;
+      break;
+    }
+  }
+  uint32_t view_host_width = uint32_t(uint64_t(copy->host_width) * width / copy->width);
+  uint32_t view_host_height = uint32_t(uint64_t(copy->host_height) * height / copy->height);
+  if (!view) {
+    FloatResolveCopyView new_view;
+    new_view.width = width;
+    new_view.height = height;
+    if (width == copy->width && height == copy->height) {
+      new_view.resource = copy->resource;
+      new_view.owns_resource = false;
+    } else {
+      // Normalized coordinates must cover only the texture's part of the copy.
+      if (!view_host_width || !view_host_height) {
+        return UINT32_MAX;
+      }
+      D3D12_RESOURCE_DESC desc = {};
+      desc.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+      desc.Width = view_host_width;
+      desc.Height = view_host_height;
+      desc.DepthOrArraySize = 1;
+      desc.MipLevels = 1;
+      desc.Format = DXGI_FORMAT_R16G16B16A16_FLOAT;
+      desc.SampleDesc.Count = 1;
+      desc.Layout = D3D12_TEXTURE_LAYOUT_UNKNOWN;
+      desc.Flags = D3D12_RESOURCE_FLAG_NONE;
+      if (FAILED(device->CreateCommittedResource(
+              &ui::d3d12::util::kHeapPropertiesDefault, provider.GetHeapFlagCreateNotZeroed(),
+              &desc, kFloatResolveCopyReadState, nullptr, IID_PPV_ARGS(&new_view.resource)))) {
+        return UINT32_MAX;
+      }
+      new_view.owns_resource = true;
+    }
+    copy->views.push_back(std::move(new_view));
+    view = &copy->views.back();
+  }
+  if (view->owns_resource && view->generation != copy->generation) {
